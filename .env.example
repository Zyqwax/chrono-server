# Port and App
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chatagram?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="super-secret-chatagram-jwt-key-2026"
JWT_EXPIRES_IN="never"

# LiveKit (WebRTC SFU Audio & Video)
LIVEKIT_URL="http://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# Cloudinary (Avatar & Media Upload)
# Option 1: Full URL
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
# Option 2: Separate keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

